rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // Helpers
    // ─────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin = a document exists at admins/{verified auth email}.
    // The email comes from the Firebase Auth token (server-verified),
    // never from client-supplied data. Bootstrap: create admins/<email>
    // manually in the Firebase console (see docs/security/ADMIN_BOOTSTRAP.md).
    function isAdmin() {
      // The conditional keeps anonymous and phone-authenticated requests from
      // evaluating an absent auth/email claim in unrelated allow clauses.
      return request.auth == null
        ? false
        : exists(/databases/$(database)/documents/admins/$(request.auth.token.get('email', '').lower()));
    }

    function myUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Moderation status enforcement. Legacy docs without a `status`
    // field are treated as active.
    function isActiveUser() {
      return isAuthenticated() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        myUserDoc().get('status', 'active') == 'active'
      );
    }

    // Trust / billing fields — only admins may set these.
    function trustFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['isVerified', 'isPremium', 'workEmailVerified', 'verificationLevel', 'verificationDetails', 'premiumSince', 'isAadhaarVerified', 'isWorkIdVerified', 'isStudentIdVerified']);
    }

    function trustFieldsSafeOnCreate() {
      return (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false)
        && (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false)
        && (!('workEmailVerified' in request.resource.data) || request.resource.data.workEmailVerified == false)
        && (!('verificationLevel' in request.resource.data) || request.resource.data.verificationLevel == 0 || request.resource.data.verificationLevel == 1)
        && (!('isAadhaarVerified' in request.resource.data) || request.resource.data.isAadhaarVerified == false)
        && (!('isWorkIdVerified' in request.resource.data) || request.resource.data.isWorkIdVerified == false)
        && (!('isStudentIdVerified' in request.resource.data) || request.resource.data.isStudentIdVerified == false)
        && (!('connectsUsed' in request.resource.data) || request.resource.data.connectsUsed == 0);
    }

    // Public user documents are readable without authentication. Contact PII
    // must therefore be absent or explicitly blank; real values belong only in
    // privateUserData/userContacts, whose reads are relationship-gated.
    function publicPiiSafe() {
      return (!('phone' in request.resource.data) || request.resource.data.phone == '')
        && (!('email' in request.resource.data) || request.resource.data.email == '')
        && (!('workEmail' in request.resource.data) || request.resource.data.workEmail == '')
        && (!('whatsappNumber' in request.resource.data) || request.resource.data.whatsappNumber == '');
    }

    function isPremiumUser() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myUserDoc().get('isPremium', false) == true;
    }

    // Free tier connection limit (FREE_CONNECT_LIMIT = 5):
    // Non-premium users may send up to 5 connection requests.
    // Server-enforced via the user's connectsUsed counter (strictly immutable downward by the user).
    function connectionQuotaAvailable() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || myUserDoc().get('connectsUsed', 0) < 5;
    }

    // Users may never decrement their own connectsUsed counter to bypass quota
    function connectsUsedUpdateSafe() {
      return !('connectsUsed' in request.resource.data)
        || !('connectsUsed' in resource.data)
        || request.resource.data.connectsUsed >= resource.data.connectsUsed;
    }

    // Moderation status is immutable except by admins (prevents self-reinstatement).
    function statusUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']);
    }

    // Shared onboarding completion requires meaningful location data but is
    // deliberately independent of a permanent owner/seeker account mode.
    // Roommate discoverability has an additional client/data eligibility gate;
    // listing creation remains protected by its own schema and approval rules.
    function onboardingDataValid() {
      return request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() > 0
        && request.resource.data.get('city', '') is string
        && request.resource.data.get('city', '').size() > 0
        && request.resource.data.get('localities', []) is list
        && request.resource.data.get('localities', []).size() > 0
        && request.resource.data.get('localities', []).size() <= 3;
    }

    function onboardingFlipValid() {
      return !(request.resource.data.keys().hasAny(['onboardingComplete']))
        || request.resource.data.onboardingComplete != true
        || resource.data.get('onboardingComplete', false) == true
        || onboardingDataValid();
    }

    // ─────────────────────────────────────────────────────────────
    // Admin override for maintenance and system tasks.
    // Secure because isAdmin() now requires an admins/{email} doc.
    // ─────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // Admin registry. Keyed by lowercased admin email.
    // Only existing admins can manage the registry; a user can read
    // their own entry (to confirm admin status).
    // ─────────────────────────────────────────────────────────────
    match /admins/{email} {
      allow get: if isAuthenticated() && 'email' in request.auth.token && request.auth.token.email.lower() == email;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    // Admin config (display lists). Readable by authenticated users,
    // writable by admins only. NOTE: rules enforce authorization via
    // /admins/{email}; config/admin.adminEmails is informational only.
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Users: public browse profile — contact PII lives in privateUserData
    match /users/{userId} {
      allow read: if true;
      allow create: if publicPiiSafe() && ((isOwner(userId) && trustFieldsSafeOnCreate()) || isAdmin());
      allow update: if publicPiiSafe() && (
        isAdmin() || (
          isOwner(userId)
          && trustFieldsUnchanged()
          && statusUnchanged()
          && onboardingFlipValid()
          && connectsUsedUpdateSafe()
        )
      );
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Private contact fields (phone, email, workEmail, whatsappNumber) — owner or admin only
    match /privateUserData/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Authenticated, explicitly opted-in roommate discovery cards. This is a
    // narrow projection, never a public view of users/{uid}.
    function publicProfileLocalitiesValid() {
      return request.resource.data.localities is list
        && request.resource.data.localities.size() > 0
        && request.resource.data.localities.size() <= 3
        && request.resource.data.localities[0] is string
        && request.resource.data.localities[0].size() > 0
        && request.resource.data.localities[0].size() <= 80
        && (request.resource.data.localities.size() < 2 || (
          request.resource.data.localities[1] is string
          && request.resource.data.localities[1].size() > 0
          && request.resource.data.localities[1].size() <= 80
        ))
        && (request.resource.data.localities.size() < 3 || (
          request.resource.data.localities[2] is string
          && request.resource.data.localities[2].size() > 0
          && request.resource.data.localities[2].size() <= 80
        ));
    }

    function publicProfileShapeValid(userId) {
      return request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'city', 'localities', 'roommateDiscoveryEnabled',
          'discoverySetupVersion', 'schemaVersion', 'updatedAt',
          'avatar', 'ageRange', 'budgetRange'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.city is string
        && request.resource.data.city.size() > 0
        && request.resource.data.city.size() <= 64
        && publicProfileLocalitiesValid()
        && request.resource.data.roommateDiscoveryEnabled == true
        && request.resource.data.discoverySetupVersion == 1
        && request.resource.data.schemaVersion == 1
        && (!('avatar' in request.resource.data) || (
          request.resource.data.avatar is string && request.resource.data.avatar.size() <= 2048
        ))
        && (!('ageRange' in request.resource.data) || (
          request.resource.data.ageRange is string && request.resource.data.ageRange.size() <= 32
        ))
        && (!('budgetRange' in request.resource.data) || (
          request.resource.data.budgetRange is string && request.resource.data.budgetRange.size() <= 32
        ));
    }

    function discoverySourceActive(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.get('onboardingComplete', false) == true
        && get(/databases/$(database)/documents/users/$(userId)).data.get('roommateDiscoveryEnabled', false) == true
        && get(/databases/$(database)/documents/users/$(userId)).data.get('status', 'active') == 'active';
    }

    match /publicProfiles/{userId} {
      allow read: if isAuthenticated()
        && resource.data.roommateDiscoveryEnabled == true
        && discoverySourceActive(userId);
      allow create, update: if isAdmin() || (
        isOwner(userId)
        && publicProfileShapeValid(userId)
        && discoverySourceActive(userId)
      );
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Server/admin-maintained anonymous listing projection. The source listing
    // remains a private workflow record during the staged migration.
    match /publicListings/{listingId} {
      allow read: if resource.data.status == 'active'
        && resource.data.ownerVerified == true;
      allow write: if isAdmin();
    }

    // Shared contact cards (WhatsApp number) — accessible only to owner, admin, or accepted connection partners
    match /userContacts/{userId} {
      allow read: if isAuthenticated() && (
        isOwner(userId)
        || isAdmin()
        || exists(/databases/$(database)/documents/acceptedPairs/$(request.auth.uid + '_' + userId))
      );
      allow write: if isOwner(userId) || isAdmin();
    }

    // Accepted connection pairing registry — created/updated on connection acceptance
    match /acceptedPairs/{pairId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.user1 ||
        request.auth.uid == resource.data.user2 ||
        isAdmin()
      );
      allow create, update: if isAdmin() || (
        isAuthenticated()
        && (request.auth.uid == request.resource.data.user1 || request.auth.uid == request.resource.data.user2)
        && request.resource.data.user1 is string
        && request.resource.data.user2 is string
        && request.resource.data.user1 != request.resource.data.user2
        && request.resource.data.connectionId is string
        && pairId == request.resource.data.user1 + '_' + request.resource.data.user2
        && existsAfter(/databases/$(database)/documents/connections/$(request.resource.data.connectionId))
        && getAfter(/databases/$(database)/documents/connections/$(request.resource.data.connectionId)).data.status == 'accepted'
        && (
          (
            getAfter(/databases/$(database)/documents/connections/$(request.resource.data.connectionId)).data.fromUserId == request.resource.data.user1
            && getAfter(/databases/$(database)/documents/connections/$(request.resource.data.connectionId)).data.toUserId == request.resource.data.user2
          )
          ||
          (
            getAfter(/databases/$(database)/documents/connections/$(request.resource.data.connectionId)).data.fromUserId == request.resource.data.user2
            && getAfter(/databases/$(database)/documents/connections/$(request.resource.data.connectionId)).data.toUserId == request.resource.data.user1
          )
        )
      );
      allow delete: if isAuthenticated()
        && (request.auth.uid == resource.data.user1 || request.auth.uid == resource.data.user2 || isAdmin());
    }

    // Listings: public read access so visitors can browse room listings.
    // Creation requires an active, onboarded user and self-owned ownerId.
    // Sprint 2A: status is restricted to the known lifecycle values and
    // suspended/banned owners cannot modify their listings. Availability
    // confirmation (`lastConfirmedAt`) may only be set by the owner or an
    // admin — seekers can never confirm someone else's room.
    function listingStatusValid() {
      return request.resource.data.get('status', 'pending_verification')
        in ['draft', 'active', 'paused', 'filled', 'closed', 'pending_verification'];
    }

    // Client validation improves the form experience, but this is the
    // authoritative boundary for direct Firestore writes.
    function listingCreateDataValid() {
      return request.resource.data.get('title', '') is string
        && request.resource.data.get('title', '').size() >= 3
        && request.resource.data.get('title', '').size() <= 160
        && request.resource.data.get('city', '') is string
        && request.resource.data.get('city', '').size() > 0
        && request.resource.data.get('city', '').size() <= 64
        && request.resource.data.get('locality', '') is string
        && request.resource.data.get('locality', '').size() > 0
        && request.resource.data.get('locality', '').size() <= 128
        && request.resource.data.get('flatType', '') is string
        && request.resource.data.get('flatType', '').size() > 0
        && request.resource.data.get('furnishing', '') is string
        && request.resource.data.get('furnishing', '').size() > 0
        && request.resource.data.get('totalRent', 0) is number
        && request.resource.data.get('totalRent', 0) > 0
        && request.resource.data.get('partnerShare', 0) is number
        && request.resource.data.get('partnerShare', 0) >= 0
        && request.resource.data.get('partnersNeeded', 0) is int
        && request.resource.data.get('partnersNeeded', 0) >= 0
        && request.resource.data.get('images', []) is list
        && request.resource.data.get('images', []).size() <= 12
        && request.resource.data.get('amenities', []) is list
        && request.resource.data.get('amenities', []).size() <= 30
        && request.resource.data.get('houseRules', []) is list
        && request.resource.data.get('houseRules', []).size() <= 20
        && request.resource.data.get('screeningQuestions', []) is list
        && request.resource.data.get('screeningQuestions', []).size() <= 10;
    }

    function completedProfileCanCreateListing() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myUserDoc().get('onboardingComplete', false) == true;
    }

    // A new listing MUST start with ownerVerified=false and status=pending_verification.
    // Owners cannot self-grant ownerVerified=true — only admin approval can set it.
    function newListingFieldsSafe() {
      return (!('ownerVerified' in request.resource.data) || request.resource.data.ownerVerified == false)
        && request.resource.data.get('status', 'pending_verification')
             in ['draft', 'pending_verification', 'paused'];
    }

    // An owner update cannot set status→'active' unless ownerVerified is already true.
    // This prevents a direct Firestore write bypass by a non-admin unverified owner.
    function listingStatusUpdateSafe() {
      // Allow any status change if listing is already ownerVerified
      return resource.data.get('ownerVerified', false) == true
        // Allow setting status to non-active values regardless of ownerVerified
        || request.resource.data.get('status', '') != 'active'
        // Allow if ownerVerified is not being changed and status is not active
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
        // Never allow status→active for unverified owners (admin path below covers that)
        || false;
    }

    // ownerVerified can only be set by admin (enforced below).
    // An owner update must never change ownerVerified.
    function ownerVerifiedUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerVerified']);
    }

    match /listings/{listingId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && isActiveUser()
        && completedProfileCanCreateListing()
        && request.resource.data.ownerId == request.auth.uid
        && listingStatusValid()
        && listingCreateDataValid()
        && newListingFieldsSafe();
      allow update: if (
        // View count increments — guests may only add exactly one view.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
          && resource.data.get('views', 0) is number
          && request.resource.data.get('views', 0) is number
          && request.resource.data.views == resource.data.get('views', 0) + 1
        ) ||
        // Admin can do anything
        isAdmin() ||
        // Owner update: must own listing, must not modify ownerVerified,
        // and must not set status→active on an unverified listing
        (
          isAuthenticated()
          && isActiveUser()
          && request.auth.uid == resource.data.ownerId
          && listingStatusValid()
          && ownerVerifiedUnchanged()
          && listingStatusUpdateSafe()
        )
      );
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.ownerId || isAdmin());
    }

    // Connections: participants or admin.
    // - Sender creates pending requests only (and must be an active user).
    // - Accept/reject decisions belong to the RECIPIENT (no self-accept).
    // - Either participant may block.
    // - Sender withdraws via delete.
    // Sprint 3C — Listing attribution: a connection MAY carry an optional
    // `listingId` recording which listing the interest originated from.
    // Enforcement boundary: if listingId is present it MUST reference an
    // existing listing OWNED BY THE RECIPIENT. A client therefore cannot
    // claim another owner's listing on its own connection.
    // Sprint FINAL — an attributed connection may only target a listing that
    // is still ACTIVE in the lifecycle sense (not closed/paused/filled).
    // Staleness (time-based freshness) cannot be expressed here without the
    // lastConfirmedAt→updatedAt→createdAt fallback chain duplicating client
    // policy; staleness is enforced by the client guard (isDiscoverable) and
    // documented as a known limitation.
    function connectionListingAttributionValid() {
      return !('listingId' in request.resource.data) || (
        request.resource.data.listingId is string
        && request.resource.data.listingId.size() > 0
        && request.resource.data.listingId.size() <= 128
        && exists(/databases/$(database)/documents/listings/$(request.resource.data.listingId))
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.ownerId
            == request.resource.data.toUserId
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.get('status', 'active') == 'active'
      );
    }

    match /connections/{connectionId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId ||
        isAdmin()
      );
      allow create: if isAuthenticated()
        && isActiveUser()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.status == 'pending'
        && connectionListingAttributionValid()
        && (isAdmin() || isPremiumUser() || connectionQuotaAvailable());
      allow update: if isAdmin() || (
        isAuthenticated()
        && (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (
          request.resource.data.status == 'blocked'
          || (request.auth.uid == resource.data.toUserId && request.resource.data.status in ['accepted', 'rejected'])
        )
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId ||
        isAdmin()
      );
    }

    // Chat rooms: only participants or admin can read/write.
    // Creation requires exactly two participants including the caller,
    // and an active (non-suspended) creator.
    function acceptedPairExists(userA, userB) {
      return exists(/databases/$(database)/documents/acceptedPairs/$(userA + '_' + userB))
        || exists(/databases/$(database)/documents/acceptedPairs/$(userB + '_' + userA));
    }

    function chatParticipantsUnchanged() {
      return request.resource.data.participants == resource.data.participants;
    }

    match /chatRooms/{roomId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isAdmin() || (
        isAuthenticated()
        && isActiveUser()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && acceptedPairExists(request.resource.data.participants[0], request.resource.data.participants[1])
      );
      allow update: if isAdmin() || (
        isAuthenticated()
        && request.auth.uid in resource.data.participants
        && chatParticipantsUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastMessageAt', 'typingStatus', 'phoneSharing'])
      );
      allow delete: if isAuthenticated() && (request.auth.uid in resource.data.participants || isAdmin());

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants || isAdmin());
        allow create: if isAuthenticated()
          && isActiveUser()
          && (request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants || isAdmin())
          && request.resource.data.senderId == request.auth.uid;
        // Participants may mark read; sender may edit own message content; admins unrestricted
        allow update: if isAdmin() || (
          isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
            || (
              request.auth.uid == resource.data.senderId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'editedAt'])
            )
          )
        );
        allow delete: if isAdmin();
      }
    }

    // Notifications: only the recipient or admin can read/update/delete.
    // Non-admin creation is limited to self-notifications. Cross-user product
    // notifications require a trusted admin/backend path rather than accepting
    // caller-controlled content for arbitrary recipients.
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAdmin() || (
        isActiveUser()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.type in ['match', 'message', 'connect', 'room', 'agreement', 'verification', 'system']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.read == false
        && (
          request.resource.data.userId == request.auth.uid
          || (
            request.resource.data.type in ['connect', 'match']
            && request.resource.data.connectionId is string
            && exists(/databases/$(database)/documents/connections/$(request.resource.data.connectionId))
            && get(/databases/$(database)/documents/connections/$(request.resource.data.connectionId)).data.status in ['pending', 'accepted']
            && (
              (
                get(/databases/$(database)/documents/connections/$(request.resource.data.connectionId)).data.fromUserId == request.auth.uid
                && get(/databases/$(database)/documents/connections/$(request.resource.data.connectionId)).data.toUserId == request.resource.data.userId
              )
              ||
              (
                get(/databases/$(database)/documents/connections/$(request.resource.data.connectionId)).data.toUserId == request.auth.uid
                && get(/databases/$(database)/documents/connections/$(request.resource.data.connectionId)).data.fromUserId == request.resource.data.userId
              )
            )
          )
        )
      );
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
    }

    // Listing views analytics: record views for analytics.
    // Field-restricted to prevent tampering.
    function listingViewRecordValid(docId) {
      return request.resource.data.keys().hasOnly(['listingId', 'ownerId', 'date', 'count'])
        && request.resource.data.listingId is string
        && request.resource.data.date is string
        && docId == request.resource.data.listingId + '_' + request.resource.data.date
        // `get()` is evaluated only when the listing exists, avoiding a rule
        // evaluation error for deliberately invalid/nonexistent listing IDs.
        && (
          exists(/databases/$(database)/documents/listings/$(request.resource.data.listingId))
            ? (!('ownerId' in request.resource.data)
              || request.resource.data.ownerId == get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.ownerId)
            : false
        )
        && request.resource.data.count == 1;
    }

    match /listingViews/{docId} {
      allow read: if isAuthenticated();
      allow create: if listingViewRecordValid(docId);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && resource.data.count is int
        && request.resource.data.count is int
        && request.resource.data.count == resource.data.count + 1;
    }

    // Ratings: authenticated users can read all; only create (no update/delete to prevent tampering)
    match /ratings/{ratingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    // Persisted match records are visible only to their two participants.
    match /matches/{matchId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId
        || request.auth.uid == resource.data.matchedUserId
        || isAdmin()
      );
      allow create: if isActiveUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.matchedUserId is string
        && request.resource.data.matchedUserId != request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Reviews (Vouches). Sprint 2B integrity:
    //   - reviewer identity bound to the auth token (no spoofing)
    //   - no self-reviews
    //   - rating must be an integer 1..5; optional text capped at 1000 chars
    // Duplicate prevention remains client-side (rules cannot query); abuse is
    // handled via the report/moderation flow.
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.targetUserId is string
        && request.resource.data.targetUserId.size() > 0
        && request.resource.data.targetUserId != request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 1000));
      allow update: if isAdmin()
        || (isAuthenticated() && request.auth.uid == resource.data.reviewerId);
      allow delete: if isAdmin()
        || (isAuthenticated() && request.auth.uid == resource.data.reviewerId);
    }

    // Skipped users: append-only, bound to the caller
    match /skippedUsers/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Agreement OTPs
    match /agreementOTPs/{agreementId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Rent Agreements
    match /agreements/{agreementId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.landlordId ||
        request.auth.uid == resource.data.tenantId ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.landlordId ||
        request.auth.uid == resource.data.tenantId ||
        isAdmin()
      );
    }

    // Verifications (User ID Verification uploads) — legacy document-style verifications
    match /verifications/{verificationId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Owner Identity Verifications — the authoritative verification state machine.
    // Each document is keyed by the owner's UID.
    // SECURITY CRITICAL:
    //   - Owners may read their own document and create/update when submitting.
    //   - Only ADMINS may set status→APPROVED/REJECTED/UNDER_REVIEW/RESUBMISSION_REQUIRED.
    //   - Only ADMINS may set ownerVerified on listings (enforced in listings rules above).
    //   - Owners CANNOT self-approve. Even a direct Firestore write by the owner cannot
    //     set status to APPROVED (the rule below rejects it).
    function ownerVerificationStatusSafeForOwner() {
      return request.resource.data.get('status', 'NOT_STARTED') in ['SUBMITTED', 'NOT_STARTED'];
    }

    match /ownerVerifications/{userId} {
      // Owner reads own verification state; admin reads all
      allow read: if isOwner(userId) || isAdmin();
      // Owner can create their own submission record
      allow create: if isOwner(userId)
        && request.resource.data.userId == request.auth.uid
        && ownerVerificationStatusSafeForOwner();
      // Owner can update when submitting/resubmitting
      // Admin can update to any state
      allow update: if isAdmin() ||
        (
          isOwner(userId)
          && (resource.data.status == 'REJECTED' || resource.data.status == 'RESUBMISSION_REQUIRED'
              || resource.data.status == 'NOT_STARTED' || resource.data.status == 'SUBMITTED')
          && ownerVerificationStatusSafeForOwner()
        );
      allow delete: if isAdmin();
    }

    // Reports: any ACTIVE authenticated user may file a report about
    // someone else. Identity of the reporter is server-enforced from the
    // auth token — it cannot be spoofed. Only admins can read or act on
    // reports. Users can never modify or delete moderation records.
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated()
        && isActiveUser()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetId != request.auth.uid
        && request.resource.data.reason in ['spam', 'spam_or_scam', 'harassment', 'inappropriate', 'inappropriate_behavior', 'fake', 'fake_profile', 'other']
        && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 2000))
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Public support entry point with a narrow immutable create schema.
    match /supportTickets/{ticketId} {
      allow create: if request.resource.data.keys().hasOnly([
          'userId', 'userEmail', 'userPhone', 'userName', 'topic', 'message', 'status', 'createdAt'
        ])
        && request.resource.data.userId == (isAuthenticated() ? request.auth.uid : 'anonymous')
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 120
        && request.resource.data.topic in ['verification', 'account', 'safety', 'listing', 'payment', 'other']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000
        && request.resource.data.status == 'open';
      allow read, update, delete: if isAdmin();
    }

    // Broadcast audit history is administrative data.
    match /broadcasts/{broadcastId} {
      allow read, write: if isAdmin();
    }

    // Admins collection
    match /admins/{adminKey} {
      allow read: if isAuthenticated()
        && (('email' in request.auth.token && request.auth.token.email.lower() == adminKey) || isAdmin());
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // Sprint 2D — Product analytics events.
    //
    // PRIVACY & SECURITY:
    //  - Any ACTIVE authenticated user may CREATE an event, but only with
    //    a whitelisted event name, their OWN uid as actorId, and small
    //    optional fields. No free-text, no PII keys.
    //  - Only ADMINS may read events or aggregates. Users can never read
    //    anyone's behavioral history (not even their own), modify, or
    //    delete events — analytics records are immutable audit data.
    // ─────────────────────────────────────────────────────────────
    function validAnalyticsEvent() {
      return request.resource.data.name in [
        'search_performed', 'listing_viewed', 'interest_sent', 'interest_accepted',
        'interest_rejected', 'connection_created', 'chat_started', 'contact_shared',
        'listing_created', 'listing_closed', 'availability_confirmed', 'match_explanation_viewed'
      ]
      && request.resource.data.actorId == request.auth.uid
      && request.resource.data.actorId is string
      && (!('entityId' in request.resource.data) || (request.resource.data.entityId is string && request.resource.data.entityId.size() <= 128))
      && (!('city' in request.resource.data) || (request.resource.data.city is string && request.resource.data.city.size() > 0 && request.resource.data.city.size() <= 64))
      && (!('resultCount' in request.resource.data) || (request.resource.data.resultCount is int && request.resource.data.resultCount >= 0));
    }

    match /analyticsEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && isActiveUser() && validAnalyticsEvent();
      allow update, delete: if false; // immutable — admin cleanup via console/scripts only
    }
  }
}
